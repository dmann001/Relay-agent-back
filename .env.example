# Gmail OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session Secret (generate a random string)
SESSION_SECRET=your_session_secret_here

# OpenAI API Configuration (optional - can be set in UI)
OPENAI_API_KEY=your_openai_api_key_here

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-side Supabase access (required for Gmail sync - tokens and the email
# metadata cache are stored server-side)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Encryption key for Gmail OAuth tokens at rest (any long random string)
TOKEN_ENCRYPTION_KEY=generate_a_long_random_string_here
