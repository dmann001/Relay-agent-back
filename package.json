{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "overrides": {
      "google-auth-library": "10.7.0",
      "shell-quote": "1.8.4"
    }
  },
  "scripts": {
    "build": "next build",
    "dev": "concurrently \"next dev\" \"ts-node --project tsconfig.server.json server/index.ts\"",
    "e2e": "pnpm test:e2e",
    "lint": "eslint .",
    "start": "next start",
    "test": "jest --config Tests/jest.config.mjs",
    "test:ci": "jest --config Tests/jest.config.mjs --ci --runInBand --coverage",
    "test:e2e": "playwright test --config Tests/playwright.config.ts",
    "setup:computer-use": "playwright install chromium",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@supabase/supabase-js": "^2.107.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "framer-motion": "^12.28.1",
    "geist": "^1.7.2",
    "google-auth-library": "^10.7.0",
    "googleapis": "^166.0.0",
    "lucide-react": "^0.454.0",
    "next": "16.2.6",
    "playwright": "^1.61.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.60.0",
    "tailwind-merge": "^2.5.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.9",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.1",
    "eslint-config-next": "16.2.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
